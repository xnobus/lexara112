# Lexara 1.12 - patch switches. 0 = disabled, 1 = enabled.
# No such file = everything enabled.
# A restart of the game is enough after every change - NO DLL rebuild needed.
#
# STEP 1 (for now): everything disabled, INCLUDING the FT_New_Library hook.
# The text MUST come back. If it does not, the culprit is not in this list.

# --- the ten patch sites (assembly stubs inside the client's code) ---
site_initbuf=1
site_allocbuf=1
site_checkgeom=1
site_checkcall=1
site_bufstream=1
site_bufalloc1=1
site_bufalloc2=1
site_bufalloc3=1
site_procbatch=1
site_glyphy=1

# --- hooks on the client's font functions ---
hook_renderbatch=1
hook_renderglyph=1
hook_getglyph=1
hook_checkgeom=1
hook_writegeom=1
hook_initline=1

# --- FreeType hooks (the client's library is replaced with Lexara's) ---
ft_hooks=1

# --- compiling and binding our own shaders ---
shaders=1

# The MSDF renderer: 1 = enabled, 0 = the client draws text its own way.
# CTRL+ALT+F11 toggles it in game as well - the write takes effect on the next launch.
msdf_enabled=0

# --- patch for the 0x00448955 crash (a texture that does not exist) ---
# Checks for NULL before the "fill with white" at 0x00448920. 0 = the crash returns.
# Independent of msdf_enabled.
site_texnullfill=1

# ---------------------------------------------------------------------------
# The D3D9 stand-in device - see docs/animation-stutter-M2.md
# ---------------------------------------------------------------------------
# To read the address of the device's virtual table, the port can create its own
# throwaway 8x8 device and release it right away. THIS WAS THE CAUSE OF THE
# ANIMATION STUTTER on every model - merely creating it was enough, even when not
# a single line of our code ran during the frame.
#
# By default it is NOT created; the client's device is caught through CreateDevice.
# Enable it for diagnostics only. Side effect of enabling it: the CTRL+ALT+F
# shortcut comes back (its handler lives in the EndScene hook installed this way).
#shared_vtable=1
